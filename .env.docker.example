# Конфигурация для docker-compose.
# Скопируйте этот файл в `.env.docker` и при необходимости измените значения:
#   cp .env.docker.example .env.docker
# Запуск:
#   docker compose --env-file .env.docker up -d --build

# --- Обязательно сменить ---
# JWT-секрет (минимум 32 символа). Сгенерируйте свой, например:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# --- База данных ---
DB_NAME=notes_db
DB_USER=notes
DB_PASSWORD=notes_pass
MYSQL_ROOT_PASSWORD=root_pass

# --- Публичный адрес приложения (для CORS на бэкенде) ---
# Укажите адрес, по которому пользователи открывают приложение в браузере.
CLIENT_URL=http://localhost:8080

# Внешний порт хоста для фронтенда
FRONTEND_PORT=8080

# --- Опционально ---
# Токен Telegram-бота для входа через Telegram (если не используется — оставьте пустым)
TELEGRAM_BOT_TOKEN=